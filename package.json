  "scripts": {
    "setup": "./scripts/setup.sh",
    "products": "./scripts/manage-products.sh",
    "products:list": "./scripts/manage-products.sh list",
    "products:add": "./scripts/manage-products.sh add",
    "products:validate": "./scripts/manage-products.sh validate",
    "landing:dev": "npx serve landing-page -l 3000",
