# ShopClaw AI — Environment Variables
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# === AI Provider (choose one) ===
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# === Telegram ===
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# === Zalo ===
# ZALO_APP_ID=your-zalo-app-id
# ZALO_SECRET_KEY=your-zalo-secret
# ZALO_OA_ACCESS_TOKEN=your-zalo-oa-token

# === WhatsApp ===
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
# WHATSAPP_VERIFY_TOKEN=your-verify-token

# === Messenger ===
# MESSENGER_PAGE_ACCESS_TOKEN=your-page-token
# MESSENGER_APP_SECRET=your-app-secret
# MESSENGER_VERIFY_TOKEN=your-verify-token

# === Discord ===
# DISCORD_BOT_TOKEN=your-discord-bot-token

# === Optional ===
# NODE_ENV=production
